# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/awardhub"

# Entra ID app registration (admin-consented application permissions)
AZURE_TENANT_ID="<publicis-tenant-id>"
AZURE_CLIENT_ID="<app-client-id>"
# Used for user sign-in (delegated OAuth). Required.
AZURE_CLIENT_SECRET="<app-client-secret>"

# How the app authenticates to Graph for application-permission calls
# (reading awards@ and writing to users' calendars).
#   managed-identity  no secret material anywhere — preferred in Azure
#   certificate       private key stays in the key store
#   secret            fallback; reuses AZURE_CLIENT_SECRET, rotate regularly
GRAPH_CREDENTIAL="secret"
# Required when GRAPH_CREDENTIAL=certificate
# GRAPH_CLIENT_CERTIFICATE_PATH="/run/secrets/graph-cert.pem"
# Optional: only for a user-assigned managed identity
# GRAPH_MANAGED_IDENTITY_CLIENT_ID="<managed-identity-client-id>"

# Shared mailbox to read
AWARDS_MAILBOX="awards@publicisgroupe.com"

# Object id of the mail-enabled security group that scopes Graph access AND who
# may sign in to the site (awards mailbox + authorised employees).
# Requires the "groups" optional claim on the app registration — the check fails
# closed. Leave unset to allow any tenant user who can sign in. See SECURITY.md.
# ACCESS_GROUP_ID="<group-object-id>"

# NextAuth (user sign-in)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<random-string>"

# Public base URL Graph can reach for webhooks (e.g. ngrok in dev)
PUBLIC_BASE_URL="http://localhost:3000"

# Shared secret echoed in Graph notifications to authenticate them.
# Treat as a credential: keep it secret and rotate it with the subscription.
GRAPH_NOTIFICATION_CLIENT_STATE="<random-string>"

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Demo mode replaces Microsoft sign-in with a passwordless account and swaps the
# real Graph gateway for an in-memory fake. The app REFUSES TO START if either
# flag is "true" while NODE_ENV=production — including `next build`. Never set
# these in a deployed environment.
# DEMO_MODE="true"
# NEXT_PUBLIC_DEMO_MODE="true"
