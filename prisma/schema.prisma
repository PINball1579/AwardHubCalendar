generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id             String   @id @default(cuid())
  sourceEventId  String   @unique
  title          String
  start          DateTime
  end            DateTime
  isAllDay       Boolean  @default(false)
  location       String?
  description    String?
  lastModified   DateTime
  status         String   @default("active") // active | cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions  Subscription[]
}

model Subscription {
  id             String   @id @default(cuid())
  userId         String
  userEmail      String
  sourceEventId  String
  copiedEventId  String?
  state          String   @default("pending") // pending | synced | failed | removed
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event          Event    @relation(fields: [sourceEventId], references: [sourceEventId])

  @@unique([userId, sourceEventId])
}

model GraphSubscription {
  id              String   @id @default(cuid())
  subscriptionId  String   @unique
  resource        String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SyncLog {
  id            String   @id @default(cuid())
  action        String
  sourceEventId String?
  userId        String?
  success       Boolean
  detail        String?
  createdAt     DateTime @default(now())
}

model DeltaCursor {
  id         String   @id @default(cuid())
  key        String   @unique
  deltaLink  String
  updatedAt  DateTime @updatedAt
}
